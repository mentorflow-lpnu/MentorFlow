# Discord bot: Developer Portal → General Information (Application ID, Public Key), Bot → Reset Token
DISCORD_BOT_TOKEN=
DISCORD_BOT_PUBLIC_KEY=
DISCORD_BOT_ID=

# Owner ID
USER_ID=

# Role IDs
EVERYONE_ID=
MENTOR_ROLE_ID=
# DEVELOPER_ROLE_ID, DEVOPS_ROLE_ID, STUDENT_QA_ID, STUDENT_QC_ID are mentioned on PR cards
# for the PR labels dev, devops, qa, qc until the mentor panel sets its own map
DEVELOPER_ROLE_ID=
DEVOPS_ROLE_ID=
STUDENT_QC_ID=
STUDENT_QA_ID=
STUDENTS_ID=
# mentioned on a PR card when no label matches
DEFAULT_PR_ROLE_ID=

# Channel IDs (fallbacks until the mentor panel sets them)
PR_REVIEW_CHANNEL_ID=
MEETINGS_CHANNEL_ID=

# GitHub fine-grained token: Pull requests, Issues, Metadata — read-only
GITHUB_TOKEN=

# Project secrets: any long random strings; MF_TASKS_SECRET must match the tasks sheet Apps Script
MF_TASKS_SECRET=
MF_INTERNAL_SECRET=

# Base URL for router → feature workflow calls
MF_INTERNAL_URL=http://localhost:5678/webhook

# Local run: the free static ngrok domain used by npm start -- --tunnel (e.g. name.ngrok-free.app)
NGROK_DOMAIN=

# Firebase: fill both with npm run env:firebase -- <service-account.json>
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Firestore emulator only; leave empty for real Firebase
FIRESTORE_URL=
FIRESTORE_TOKEN=
